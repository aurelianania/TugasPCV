// VIDEO FILTERING
import cv2

cap = cv2.VideoCapture(0)

while True:
    ret, frame = cap.read()

    if not ret:
        print("Gagal membaca webcam")
        break

    (w, h, c) = frame.shape

    for i in range(w):
        for j in range(h):
            #frame[i, j, 1] = 0  # Green = 0
            #frame[i, j, 0] = 0  # Blue = 0
            frame[i, j, 2] = 0

    cv2.imshow("Webcam Filter", frame)

    if cv2.waitKey(1) & 0xFF == ord('q'):
        break

cap.release()
cv2.destroyAllWindows()
